# OpenMetadata Configuration
OPENMETADATA_URL=http://localhost:8585/api

# JWT Token — automatically injected by deploy.py (no manual step needed).
# If auto-retrieval fails, get it manually:
#   http://localhost:8585 > Settings > Bots > ingestion-bot > Copy JWT Token
OPENMETADATA_JWT_TOKEN=your_jwt_token_here

# Cluster (ne pas modifier)
CLUSTER_NAME=openmetadata-games

# Authentication (ne pas modifier)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# MySQL Database
MYSQL_ROOT_PASSWORD=YOUR_STRONG_PASSWORD_HERE
MYSQL_DATABASE=openmetadata_db
MYSQL_USER=openmetadata_user
MYSQL_PASSWORD=YOUR_STRONG_PASSWORD_HERE

# Airflow Database
AIRFLOW_DB=airflow_db
AIRFLOW_USER=airflow_user
AIRFLOW_PASSWORD=YOUR_STRONG_PASSWORD_HERE

# Fernet Key for Airflow (must be 32 url-safe base64-encoded bytes)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
METADATA_FERNET_KEY=YOUR_FERNET_KEY_HERE

# Elasticsearch
ES_JAVA_OPTS=-Xms1024m -Xmx1024m

# Logging
LOG_LEVEL=INFO
